<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginTop="7dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="7dp"
    android:background="@drawable/facility_card_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvClassCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#F4E5FF"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="YOGA &amp; MIND"
            android:textColor="#7B1FA2"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSkillLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="All Levels"
            android:textColor="#666666"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvClassTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6:30 AM"
            android:textColor="#222222"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Duration -->
    <TextView
        android:id="@+id/tvClassDuration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="50 min"
        android:textColor="#999999"
        android:textSize="10sp" />

    <!-- Class name -->
    <TextView
        android:id="@+id/tvClassName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Sunrise Vinyasa Flow"
        android:textColor="#222222"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Instructor -->
    <TextView
        android:id="@+id/tvInstructor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="led by Hannah L."
        android:textColor="#666666"
        android:textSize="12sp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="#EEEEEE" />

    <!-- Bottom row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvClassFacility"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="East Bank Studio"
            android:textColor="#666666"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvSpotsAvailable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="47 spots left"
            android:textColor="#008A55"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBookSpot"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Book Spot"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Keep date available to adapter -->
    <TextView
        android:id="@+id/tvClassDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>