<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="30dp">

        <!-- Greeting -->
        <TextView
            android:id="@+id/tvCrowdsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="Good Afternoon, Gopher!"
            android:textColor="#222222"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Location selector -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/locationToggleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            app:checkedButton="@id/btnEastBank"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEastBank"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="East Bank"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStPaul"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="St. Paul"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCookeHall"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Cooke Hall"
                android:textAllCaps="false"
                android:textSize="12sp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Overall facility card -->
        <LinearLayout
            android:id="@+id/facilitySummaryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/facility_card_background"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Percentage + status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOverallPercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#8B0015"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBusyStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="LOADING"
                    android:textColor="#8B0015"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvOverallFacilityName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="University Recreation Center"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOverallCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Loading occupancy..."
                android:textColor="#666666"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/progressOverall"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="14dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#FFB000" />

        </LinearLayout>

        <!-- Area title -->
        <TextView
            android:id="@+id/tvAreaTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="22dp"
            android:text="AREA OCCUPANCY BREAKDOWN"
            android:textColor="#555555"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Individual areas -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFacilities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

        <!-- Forecast title -->
        <TextView
            android:id="@+id/tvForecastTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="26dp"
            android:text="HOURLY BUSYNESS FORECAST"
            android:textColor="#555555"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Forecast card -->
        <LinearLayout
            android:id="@+id/forecastCard"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/facility_card_background"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="20dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp">

            <!-- 10 AM -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvForecastPercent1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="0%"
                    android:textColor="#555555"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/barForecast1"
                    android:layout_width="24dp"
                    android:layout_height="10dp"
                    android:background="#FFB000" />

                <TextView
                    android:id="@+id/tvForecastHour1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="10 AM"
                    android:textColor="#666666"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- 12 PM -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvForecastPercent2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="0%"
                    android:textColor="#555555"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/barForecast2"
                    android:layout_width="24dp"
                    android:layout_height="10dp"
                    android:background="#FFB000" />

                <TextView
                    android:id="@+id/tvForecastHour2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="12 PM"
                    android:textColor="#666666"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- 2 PM -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvForecastPercent3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="0%"
                    android:textColor="#555555"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/barForecast3"
                    android:layout_width="24dp"
                    android:layout_height="10dp"
                    android:background="#FFB000" />

                <TextView
                    android:id="@+id/tvForecastHour3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="2 PM"
                    android:textColor="#666666"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- 4 PM -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvForecastPercent4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="0%"
                    android:textColor="#8B0015"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/barForecast4"
                    android:layout_width="24dp"
                    android:layout_height="10dp"
                    android:background="#8B0015" />

                <TextView
                    android:id="@+id/tvForecastHour4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="4 PM"
                    android:textColor="#666666"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 6 PM -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvForecastPercent5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="0%"
                    android:textColor="#555555"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/barForecast5"
                    android:layout_width="24dp"
                    android:layout_height="10dp"
                    android:background="#FFB000" />

                <TextView
                    android:id="@+id/tvForecastHour5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="6 PM"
                    android:textColor="#666666"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- 8 PM -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvForecastPercent6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="0%"
                    android:textColor="#555555"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/barForecast6"
                    android:layout_width="24dp"
                    android:layout_height="10dp"
                    android:background="#FFB000" />

                <TextView
                    android:id="@+id/tvForecastHour6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="8 PM"
                    android:textColor="#666666"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>