<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:paddingTop="20dp">

    <!-- Page title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:text="UMN GROUP CLASS RESERVATIONS"
        android:textColor="#222222"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        android:text="Scan and reserve your spot for today's elite Gopher group fitness sessions."
        android:textColor="#666666"
        android:textSize="13sp" />

    <!-- Search and filter card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/facility_card_background"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Search -->
        <EditText
            android:id="@+id/etClassSearch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/facility_card_background"
            android:hint="Search classes or instructors"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#222222"
            android:textColorHint="#999999"
            android:textSize="13sp" />

        <!-- Category title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="CATEGORY"
            android:textColor="#666666"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Category buttons -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/categoryToggleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:checkedButton="@id/btnCategoryAll"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCategoryAll"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="0.7"
                android:text="All"
                android:textAllCaps="false"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCategoryCardio"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Cardio"
                android:textAllCaps="false"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCategoryStrength"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.1"
                android:text="Strength"
                android:textAllCaps="false"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCategoryYoga"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.3"
                android:text="Yoga &amp; Mind"
                android:textAllCaps="false"
                android:textSize="9sp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Skill title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="SKILL LEVEL"
            android:textColor="#666666"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Skill buttons -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/skillToggleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:checkedButton="@id/btnSkillAll"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSkillAll"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="0.7"
                android:text="All"
                android:textAllCaps="false"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSkillAllLevels"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.1"
                android:text="All Levels"
                android:textAllCaps="false"
                android:textSize="9sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSkillIntermediate"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.4"
                android:text="Intermediate"
                android:textAllCaps="false"
                android:textSize="9sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSkillAdvanced"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.1"
                android:text="Advanced"
                android:textAllCaps="false"
                android:textSize="9sp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>

    <!-- Number of results -->
    <TextView
        android:id="@+id/tvClassResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="22dp"
        android:text="Loading classes..."
        android:textColor="#777777"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Class list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvClasses"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />

</LinearLayout>